# =============================================================================
# DZ News Monitor – environment configuration
# Copy this file to .env and fill in your values.
# For local development overrides, use .env.local (not committed).
# =============================================================================

# --- Flask -------------------------------------------------------------------
FLASK_PORT=5088
FLASK_SECRET_KEY=change-me-to-a-random-secret

# --- Database (MySQL / MariaDB) ----------------------------------------------
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=dz_news
DB_USER=
DB_PASS=

# --- SerpAPI (Google News search) -------------------------------------------
# Get your key at https://serpapi.com/
SERPAPI_KEY=

# Search parameters (defaults are good for Algeria/French)
SERP_HL=fr
SERP_GL=dz
SERP_NUM=10
SERP_WHEN=7d
SERP_ENGINE=

# --- Translation backend (Arabic → French) ----------------------------------
# Choose one: local | deepl | azure  (default: local)
TRANSLATOR_BACKEND=local

# Local MarianMT service URL (used when TRANSLATOR_BACKEND=local)
TRANSLATOR_URL=https://your-local-translator.example.com

# DeepL API key (used when TRANSLATOR_BACKEND=deepl)
# Get your key at https://www.deepl.com/pro-api
DEEPL_API_KEY=

# Azure Cognitive Translator (used when TRANSLATOR_BACKEND=azure)
# Get your key at https://portal.azure.com
AZURE_TRANSLATOR_KEY=
AZURE_TRANSLATOR_REGION=westeurope

# AI klasifikácia športových článkov (build.nvidia.com) — bez kľúča je vypnutá
NVIDIA_API_KEY=
NVIDIA_MODEL=nvidia/nemotron-3.5-bolt-e4b
AI_CLASSIFY_ENABLED=1
AI_CLASSIFY_DELAY=1.5
# AI návrh relevancie k SK–DZ (ai_relevance.py, migrácia 004) — len návrh, rovnaký NVIDIA_API_KEY
AI_RELEVANCE_ENABLED=1
AI_RELEVANCE_MODEL=nvidia/nemotron-3-ultra-550b-a55b
# domény bez posudzovania (aj subdomény) — mfa.gov.dz: extrahovaný text je menu webu
AI_RELEVANCE_SKIP_DOMAINS=mfa.gov.dz
AI_RELEVANCE_BATCH=20
# Model pre TRANSLATOR_BACKEND=nvidia (preklad AR→FR cez LLM, rovnaký NVIDIA_API_KEY)
NVIDIA_TRANSLATE_MODEL=nvidia/nemotron-3-super-120b-a12b

# Read-only API pre AI (/api/articles, /api/openapi.json) — čiarkou oddelené kľúče; prázdne = API vypnuté
# Kľúč vygeneruješ napr.: python -c "import secrets; print(secrets.token_urlsafe(32))"
API_KEYS=
# Vzdialený MCP server (kontajner dz-mcp) pre claude.ai — kľúče do adresy konektora https://<host>/mcp/<kľúč>
# (prázdne = použijú sa API_KEYS). Vygeneruj: python3 -c "import secrets; print(secrets.token_urlsafe(32))"
MCP_TOKENS=
MCP_PORT=5090

# --- Extraction --------------------------------------------------------------
EXTRACT_MAX=50
# Relé — HTTP proxy na RPi v Alžírsku cez VPN (DEPLOYMENT.md „Relé cez Alžírsko“); prázdne = vypnuté.
# Domény z FETCH_RELAY_DOMAINS idú vždy cez relé, ostatné len pri timeoute / chybe spojenia / 403.
FETCH_RELAY_PROXY=
FETCH_RELAY_DOMAINS=aps.dz,elmoudjahid.dz
EXTRACT_ONLY_MISSING=true

# --- Preferred domains (optional, overrides sources.json) -------------------
# Comma-separated list of Algerian news domains to prioritize
# PREFERRED_DOMAINS=elmoudjahid.com,aps.dz,tsa-algerie.com

# --- Paths (optional, defaults relative to project root) --------------------
# BUNDLE_DIR=./bundle
# RUNS_DIR=./bundle/runs
# LOG_DIR=./logs
# LATEST_BUNDLE_PATH=./bundle/latest/news_bundle.json

# --- Logging -----------------------------------------------------------------
LOG_FILE=app.log
LOG_LEVEL=INFO
LOG_PREFIX=dznews
# LOG_MAX_BYTES=5242880
# LOG_BACKUP_COUNT=5

# --- SMTP notifications (optional) ------------------------------------------
# Čas denného behu scheduler.py (HH:MM, časové pásmo podľa TZ), predvolene 04:30
SCHEDULE_TIME=04:30
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
NOTIFY_TO=