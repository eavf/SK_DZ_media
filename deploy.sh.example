#!/usr/bin/env bash
# deploy.sh — zbuilduje image, pushne na Docker Hub, nasadí na server
# Použitie:
#   ./deploy.sh              — full deploy (build + push + scp + pull na server)
#   ./deploy.sh --no-rebuild — skopíruje templates/config/.env/static a reštartuje
#   ./deploy.sh --tpl-only   — len šablóny (bez reštartu, hneď aktívne)
#   ./deploy.sh --restart    — len reštartuje kontajner na serveri
#   ./deploy.sh --rebuild    — len build + push (bez deployu na server)
#   ./deploy.sh --check      — len porovná .env/config/templates/static so serverom
#
# Nastavenie:
#   1. Skopíruj ako deploy.sh: cp deploy.sh.example deploy.sh
#   2. Uprav premenné nižšie podľa svojho prostredia
#   3. Pridaj SSH alias do ~/.ssh/config:
#      Host myserver
#          HostName 192.168.1.100
#          Port 22
#          User myuser
#          IdentityFile ~/.ssh/id_rsa

set -euo pipefail

# ── Konfigurácia — uprav podľa svojho prostredia ──────────────────────────────
DOCKER_IMAGE="dockerhub-username/image-name:latest"
SYNOLOGY_HOST="myserver"          # alias z ~/.ssh/config
REMOTE_DIR="/path/to/remote/app"  # napr. /volume1/docker/dz_news
LOCAL_DIR="$(cd "$(dirname "$0")" && pwd)"

# Verzia vpísaná do image (zobrazí sa v pätičke webu a v /admin/maintenance)
GIT_COMMIT="$(git -C "${LOCAL_DIR}" rev-parse --short HEAD 2>/dev/null || echo unknown)"
if [[ -n "$(git -C "${LOCAL_DIR}" status --porcelain --untracked-files=no 2>/dev/null)" ]]; then
  GIT_COMMIT="${GIT_COMMIT}-dirty"
fi
BUILD_DATE="$(date '+%Y-%m-%d %H:%M')"
BUILD_ARGS=(--build-arg "GIT_COMMIT=${GIT_COMMIT}" --build-arg "BUILD_DATE=${BUILD_DATE}")
SCP="scp -O"                      # -O = legacy SCP protokol (potrebné pre Synology)
SSH="ssh -t ${SYNOLOGY_HOST}"
DOCKER="sudo /usr/local/bin/docker"  # cesta k docker na serveri

# ── Kontrola rozdielov lokál ↔ server ─────────────────────────────────────────
# Deploy prepisuje na serveri .env, docker-compose.yml, config/, templates/ a static/ lokálnymi verziami.
# check_remote ukáže, čo by sa prepísalo (hodnoty .env len ako hash, nikdy sa nevypisujú).
# Návratový kód 1 = na serveri je niečo, čo by sa stratilo (iná hodnota / kľúč len na serveri / iný súbor).
_env_hashes() {
  local line k v
  while IFS= read -r line || [[ -n $line ]]; do
    [[ $line =~ ^[A-Za-z_][A-Za-z0-9_]*= ]] || continue
    k="${line%%=*}"; v="${line#*=}"
    printf '%s %s\n' "$k" "$(printf %s "$v" | md5sum | cut -c1-12)"
  done | sort -u -k1,1
}

check_remote() {
  local tmp risky=0
  tmp="$(mktemp -d)"
  echo "--> Kontrolujem rozdiely lokál ↔ ${SYNOLOGY_HOST}:${REMOTE_DIR} ..."

  # .env
  _env_hashes < "${LOCAL_DIR}/.env" > "${tmp}/env_l"
  ssh -o BatchMode=yes "${SYNOLOGY_HOST}" "cat ${REMOTE_DIR}/.env 2>/dev/null" | _env_hashes > "${tmp}/env_r"
  join -a1 -a2 -e MISSING -o 0,1.2,2.2 "${tmp}/env_l" "${tmp}/env_r" > "${tmp}/env_j"
  while read -r k l r; do
    if [[ $l == MISSING ]]; then echo "  !! .env ${k}: len na serveri — deploy ho ZMAŽE"; risky=1
    elif [[ $r == MISSING ]]; then echo "     .env ${k}: len lokálne — deploy ho pridá"
    elif [[ $l != "$r" ]]; then echo "  !! .env ${k}: iná hodnota — deploy ju PREPÍŠE"; risky=1
    fi
  done < "${tmp}/env_j"

  # súbory, ktoré deploy kopíruje
  (cd "${LOCAL_DIR}" && find docker-compose.yml config templates static -type f \
      ! -path '*__pycache__*' ! -name '*.pyc' 2>/dev/null | sort) > "${tmp}/files"
  (cd "${LOCAL_DIR}" && while read -r f; do md5sum "$f"; done < "${tmp}/files") | sort -k2 > "${tmp}/md5_l"
  ssh -o BatchMode=yes "${SYNOLOGY_HOST}" \
    "cd ${REMOTE_DIR} && while read -r f; do [ -f \"\$f\" ] && md5sum \"\$f\"; done" \
    < "${tmp}/files" | sort -k2 > "${tmp}/md5_r"
  join -1 2 -2 2 -a1 -e MISSING -o 0,1.1,2.1 "${tmp}/md5_l" "${tmp}/md5_r" > "${tmp}/md5_j"
  while read -r f l r; do
    if [[ $r == MISSING ]]; then echo "     ${f}: nový (len lokálne)"
    elif [[ $l != "$r" ]]; then echo "  !! ${f}: na serveri iný — deploy ho PREPÍŠE (zmena cez admin UI?)"; risky=1
    fi
  done < "${tmp}/md5_j"

  rm -rf "${tmp}"
  if (( risky )); then
    echo "==> Na serveri sú rozdiely, ktoré by deploy prepísal (označené !!)."
  else
    echo "==> OK — deploy na serveri nič neprepíše ani nezmaže."
  fi
  return $risky
}

# Pred prepísaním súborov na serveri: pri rizikových rozdieloch sa opýta (DEPLOY_SKIP_CHECK=1 preskočí)
confirm_remote() {
  [[ ${DEPLOY_SKIP_CHECK:-0} == 1 ]] && return 0
  check_remote && return 0
  if [[ ! -t 0 ]]; then
    echo "!! Neinteraktívny beh — deploy zastavený. Over rozdiely alebo spusti s DEPLOY_SKIP_CHECK=1." >&2
    exit 1
  fi
  read -r -p "Prepísať server lokálnymi verziami? [y/N] " ans
  [[ $ans == [yY]* ]] || { echo "Deploy zrušený."; exit 1; }
}
# ──────────────────────────────────────────────────────────────────────────────

MODE="full"
case "${1:-}" in
  --tpl-only)    MODE="tpl" ;;
  --no-rebuild)  MODE="no-rebuild" ;;
  --restart)     MODE="restart" ;;
  --rebuild)     MODE="rebuild" ;;
  --check)       MODE="check" ;;
  -h|--help)
    echo "Použitie: ./deploy.sh [MOŽNOSŤ]"
    echo ""
    echo "  (bez možnosti)   Full deploy: build image → push Docker Hub → scp konfig → pull + restart na serveri"
    echo "  --no-rebuild     Skopíruje config/.env/static na server a reštartuje (bez buildu)"
    echo "  --tpl-only       Len šablóny (templates/) na server, bez reštartu — zmeny sú hneď aktívne"
    echo "  --restart        Len reštartuje kontajnery na serveri"
    echo "  --rebuild        Len build + push na Docker Hub (bez nasadenia na server)"
    echo "  --check          Len porovná .env, docker-compose.yml, config, templates, static so serverom"
    echo "  -h, --help       Zobrazí túto nápovedu"
    echo ""
    echo "  Pred deployom, ktorý prepisuje súbory na serveri, sa kontrola spustí automaticky"
    echo "  (preskočenie: DEPLOY_SKIP_CHECK=1 ./deploy.sh)"
    exit 0
    ;;
esac

if [[ $MODE == "check" ]]; then
  check_remote || exit 1
  exit 0
fi

if [[ $MODE == "tpl" ]]; then
  confirm_remote
  echo "--> Kopírujem len šablóny..."
  ${SCP} -r "${LOCAL_DIR}/templates" "${SYNOLOGY_HOST}:${REMOTE_DIR}/"
  echo "==> Hotovo. Obnov stránku v prehliadači."
  exit 0
fi

if [[ $MODE == "no-rebuild" ]]; then
  confirm_remote
  echo "--> Kopírujem config, .env a static (bez rebuildu)..."
  tar -czf - --exclude='__pycache__' --exclude='*.pyc' -C "${LOCAL_DIR}" config | \
    ssh "${SYNOLOGY_HOST}" "tar -xzf - -C ${REMOTE_DIR} && chmod 666 ${REMOTE_DIR}/config/*.json"
  ${SCP} "${LOCAL_DIR}/.env"         "${SYNOLOGY_HOST}:${REMOTE_DIR}/"
  ${SCP} -r "${LOCAL_DIR}/static"    "${SYNOLOGY_HOST}:${REMOTE_DIR}/"
  echo "--> Rešartujem kontajner..."
  ${SSH} "cd ${REMOTE_DIR} && ${DOCKER} compose restart"
  echo "==> Hotovo."
  exit 0
fi

if [[ $MODE == "restart" ]]; then
  echo "--> Rešartujem kontajner na serveri..."
  ${SSH} "cd ${REMOTE_DIR} && ${DOCKER} compose up --force-recreate -d"
  echo "==> Hotovo."
  exit 0
fi

if [[ $MODE == "rebuild" ]]; then
  echo "--> Buildujem Docker image (${GIT_COMMIT}, ${BUILD_DATE})..."
  docker build "${BUILD_ARGS[@]}" -t "${DOCKER_IMAGE}" "${LOCAL_DIR}"
  echo "--> Pushnem na Docker Hub..."
  docker push "${DOCKER_IMAGE}"
  echo "==> Image pushnutý. Nasaď ho cez: ./deploy.sh --restart"
  exit 0
fi

# ── 0. Kontrola rozdielov (pred buildom, aby sa zbytočne nečakalo) ──────────────
confirm_remote

# ── 1. Build image ─────────────────────────────────────────────────────────────
echo "--> Buildujem Docker image (${GIT_COMMIT}, ${BUILD_DATE})..."
docker build "${BUILD_ARGS[@]}" -t "${DOCKER_IMAGE}" "${LOCAL_DIR}"

# ── 2. Push na Docker Hub ──────────────────────────────────────────────────────
echo "--> Pushnem na Docker Hub..."
docker push "${DOCKER_IMAGE}"

# ── 3. Skopíruj konfig, .env a šablóny na server ──────────────────────────────
echo "--> Kopírujem konfig na server..."

${SCP} \
  "${LOCAL_DIR}/docker-compose.yml" \
  "${LOCAL_DIR}/.env" \
  "${SYNOLOGY_HOST}:${REMOTE_DIR}/"

${SCP} -r "${LOCAL_DIR}/templates" "${SYNOLOGY_HOST}:${REMOTE_DIR}/"
tar -czf - --exclude='__pycache__' --exclude='*.pyc' -C "${LOCAL_DIR}" config | \
  ssh "${SYNOLOGY_HOST}" "tar -xzf - -C ${REMOTE_DIR} && chmod 666 ${REMOTE_DIR}/config/*.json"
${SCP} -r "${LOCAL_DIR}/static"    "${SYNOLOGY_HOST}:${REMOTE_DIR}/"

# ── 4. Nastav práva na zapisovateľné adresáre ─────────────────────────────────
echo "--> Nastavujem práva..."
${SSH} "sudo /bin/mkdir -p ${REMOTE_DIR}/logs ${REMOTE_DIR}/data ${REMOTE_DIR}/bundle && \
  sudo /bin/chmod 777 \
  ${REMOTE_DIR}/logs \
  ${REMOTE_DIR}/data \
  ${REMOTE_DIR}/bundle \
  ${REMOTE_DIR}/templates \
  ${REMOTE_DIR}/config \
  ${REMOTE_DIR}/static"

# ── 5. Pull nový image a reštartuj ────────────────────────────────────────────
echo "--> Pullnem nový image a reštartujem na serveri..."
${SSH} "cd ${REMOTE_DIR} && ${DOCKER} compose pull && ${DOCKER} compose up --force-recreate -d && ${DOCKER} image prune -f"
echo "==> Deploy hotový."
